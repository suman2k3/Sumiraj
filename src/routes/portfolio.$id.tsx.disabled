import { createFileRoute, Link, useParams } from "@tanstack/react-router";
import { useMemo, useState } from "react";
import { Layout } from "@/components/site/Layout";
import { usePortfolioProjects, getPortfolioProjectById } from "@/lib/portfolioStore";
import { 
  MapPin, 
  ArrowLeft, 
  ArrowRight, 
  CheckCircle2, 
  Ruler, 
  ShieldCheck, 
  Factory, 
  Maximize2,
  X,
  Share2,
  Building2,
  ChevronRight,
  Layers
} from "lucide-react";
import { motion, AnimatePresence } from "framer-motion";

export const Route = createFileRoute("/portfolio/$id")({
  head: ({ params }) => {
    const project = getPortfolioProjectById(params.id);
    if (!project) {
      return {
        meta: [{ title: "Project Not Found | Sumiraj" }],
      };
    }
    return {
      meta: [
        { title: `${project.title} | Completed PEB Project | Sumiraj` },
        { name: "description", content: `${project.description.substring(0, 155)}...` },
        { property: "og:title", content: project.title },
        { property: "og:description", content: project.description },
        { property: "og:image", content: project.image },
        { property: "og:type", content: "website" },
      ],
    };
  },
  component: ProjectDetails,
});

function ProjectDetails() {
  const { id } = useParams({ from: "/portfolio/$id" });
  const portfolioProjects = usePortfolioProjects();

  const project = useMemo(() => {
    return portfolioProjects.find((p) => p.id === id || p.slug === id || p._id === id);
  }, [portfolioProjects, id]);

  const relatedProjects = useMemo(() => {
    if (!project) return [];
    return portfolioProjects.filter((p) => p.id !== project.id && p._id !== project._id).slice(0, 3);
  }, [portfolioProjects, project]);

  const [activeImage, setActiveImage] = useState<string>("");
  const [lightboxOpen, setLightboxOpen] = useState<boolean>(false);

  if (!project) {
    return (
      <Layout>
        <div className="container-x mx-auto py-24 text-center">
          <h1 className="text-3xl font-bold text-slate-900">Project Not Found</h1>
          <p className="mt-4 text-slate-650">The portfolio project you are looking for does not exist.</p>
          <Link to="/portfolio" className="mt-6 inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-xs font-bold text-white">
            <ArrowLeft size={14} /> Back to Portfolio
          </Link>
        </div>
      </Layout>
    );
  }

  const displayedImage = activeImage || project.image;

  return (
    <Layout>
      {/* Sleek Breadcrumb Navigation Bar */}
      <div className="bg-slate-900 text-slate-300 py-3.5 border-b border-slate-800">
        <div className="container-x mx-auto max-w-[1400px] flex items-center justify-between text-xs">
          <div className="flex items-center gap-2">
            <Link to="/" className="hover:text-accent transition">Home</Link>
            <ChevronRight size={12} className="text-slate-600" />
            <Link to="/portfolio" className="hover:text-accent transition">Portfolio</Link>
            <ChevronRight size={12} className="text-slate-600" />
            <span className="text-accent font-semibold truncate max-w-[180px] sm:max-w-xs">{project.title}</span>
          </div>
          <Link to="/portfolio" className="inline-flex items-center gap-1.5 text-xs font-bold text-white hover:text-accent transition">
            <ArrowLeft size={14} /> Back to Projects
          </Link>
        </div>
      </div>

      {/* Main Showcase Section */}
      <section className="py-12 md:py-20 bg-white">
        <div className="container-x mx-auto max-w-[1400px]">
          
          {/* Project Header Banner */}
          <div className="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 pb-8 border-b border-slate-100">
            <div className="max-w-4xl space-y-3">
              <div className="flex items-center gap-3">
                <span className="rounded-full bg-accent/10 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-accent border border-accent/20">
                  {project.category}
                </span>
                <span className="text-xs text-slate-400 font-semibold flex items-center gap-1">
                  <CheckCircle2 size={13} className="text-accent" /> Turnkey PEB Project
                </span>
              </div>

              <h1 className="font-display text-3xl font-extrabold leading-tight text-slate-900 sm:text-4xl md:text-5xl">
                {project.title}
              </h1>

              <div className="flex items-center gap-2 text-sm font-semibold text-slate-600">
                <MapPin size={16} className="text-accent shrink-0" />
                <span>{project.location}</span>
              </div>
            </div>

            {/* Quick Stat Bar */}
            <div className="flex items-center gap-4 bg-slate-50 border border-slate-200/80 rounded-2xl p-4 shrink-0">
              <div className="pr-4 border-r border-slate-200">
                <span className="text-[10px] font-bold uppercase text-slate-400 block">Covered Area</span>
                <span className="text-sm font-extrabold text-slate-900">{project.specifications.area}</span>
              </div>
              <div>
                <span className="text-[10px] font-bold uppercase text-slate-400 block">Structure</span>
                <span className="text-sm font-extrabold text-slate-900">{project.specifications.industry}</span>
              </div>
            </div>
          </div>

          {/* Project Gallery Viewer */}
          <div className="space-y-4 mb-14">
            <div className="aspect-[21/9] w-full overflow-hidden rounded-2xl bg-slate-950 border border-slate-200 shadow-lg relative group">
              <img 
                src={displayedImage} 
                alt={`${project.title} featured view`} 
                className="h-full w-full object-cover transition-all duration-500" 
              />
              <button
                onClick={() => setLightboxOpen(true)}
                className="absolute bottom-4 right-4 rounded-xl bg-slate-950/80 hover:bg-slate-950 px-4 py-2.5 text-xs font-bold text-white shadow-xl backdrop-blur-md transition flex items-center gap-2 border border-white/10"
              >
                <Maximize2 size={14} /> Fullscreen View
              </button>
            </div>

            {/* Gallery Thumbnails */}
            {project.gallery && project.gallery.length > 1 && (
              <div className="flex gap-4 overflow-x-auto pb-2">
                {project.gallery.map((imgUrl, idx) => (
                  <button 
                    key={idx}
                    onClick={() => setActiveImage(imgUrl)}
                    className={`aspect-[16/10] w-36 rounded-xl overflow-hidden border-2 bg-slate-50 shrink-0 transition-all ${
                      displayedImage === imgUrl ? "border-accent shadow-md scale-95" : "border-slate-200 hover:border-accent/50"
                    }`}
                  >
                    <img src={imgUrl} alt={`gallery thumbnail ${idx + 1}`} className="h-full w-full object-cover" />
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Main Specs & Narrative Grid */}
          <div className="grid gap-12 lg:grid-cols-[1fr_380px] lg:items-start">
            
            {/* Left Column */}
            <div className="space-y-12 min-w-0">
              
              {/* Project Description */}
              <div>
                <h2 className="font-display text-2xl font-extrabold text-slate-900 border-b border-slate-100 pb-4 mb-5 flex items-center gap-2.5">
                  <Building2 size={24} className="text-accent" /> Project Overview & Scope
                </h2>
                <p className="text-slate-700 leading-relaxed text-base sm:text-lg">
                  {project.description}
                </p>
                <p className="mt-4 text-slate-600 leading-relaxed text-sm sm:text-base">
                  Every structural component was engineered and precision-fabricated in-house at Sumiraj's automated steel manufacturing facility in Greater Noida. The layout design matches heavy machinery load requirements, localized wind/seismic standards, and optimizes structural efficiency to achieve a cost-effective, high-durability space.
                </p>
              </div>

              {/* Highlights List */}
              <div className="bg-slate-50 rounded-2xl border border-slate-200 p-8 shadow-sm">
                <h3 className="font-display text-xl font-bold text-slate-900 mb-6 flex items-center gap-2.5">
                  <ShieldCheck size={24} className="text-accent" /> Engineering & Execution Highlights
                </h3>
                <ul className="grid gap-4 sm:grid-cols-1">
                  {project.highlights.map((highlight, idx) => (
                    <li key={idx} className="flex items-start gap-3 bg-white p-4 rounded-xl border border-slate-150">
                      <CheckCircle2 size={20} className="text-accent shrink-0 mt-0.5" />
                      <span className="text-slate-700 text-sm font-medium leading-relaxed">
                        {highlight}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>

            {/* Right Column: Specification Cards Sidebar */}
            <aside className="space-y-6 lg:sticky lg:top-24">
              
              {/* Technical Specification Matrix */}
              <div className="rounded-2xl border border-slate-200 p-6 bg-slate-50 shadow-sm space-y-6">
                <h4 className="font-display text-xs font-bold uppercase tracking-widest text-slate-500 border-b border-slate-200 pb-3 flex items-center gap-2">
                  <Factory size={16} className="text-accent" /> Structural Specifications
                </h4>
                
                <div className="space-y-4">
                  <div className="bg-white p-3.5 rounded-xl border border-slate-150">
                    <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Manufacturing Process</span>
                    <p className="text-xs font-bold text-slate-900 mt-1">{project.specifications.process}</p>
                  </div>

                  <div className="bg-white p-3.5 rounded-xl border border-slate-150">
                    <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Materials Used</span>
                    <p className="text-xs font-bold text-slate-900 mt-1">{project.specifications.materials}</p>
                  </div>

                  <div className="bg-white p-3.5 rounded-xl border border-slate-150">
                    <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Industry Application</span>
                    <p className="text-xs font-bold text-slate-900 mt-1">{project.specifications.industry}</p>
                  </div>

                  <div className="bg-white p-3.5 rounded-xl border border-slate-150">
                    <span className="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Total Covered Area</span>
                    <p className="text-xs font-bold text-slate-900 mt-1">{project.specifications.area}</p>
                  </div>
                </div>
              </div>

              {/* Sidebar Consult CTA */}
              <div className="rounded-2xl bg-slate-950 p-6 text-white border border-slate-800 shadow-lg relative overflow-hidden">
                <span className="text-[10px] font-bold uppercase tracking-widest text-accent flex items-center gap-1.5">
                  <Ruler size={14} /> Structural Consultation
                </span>
                <h4 className="font-display text-lg font-bold mt-2 text-white">Have a similar project requirement?</h4>
                <p className="mt-2 text-xs leading-relaxed text-slate-400">
                  Our structural engineers will analyze your preliminary land and span requirements, providing preliminary design layouts and cost estimates within 48 hours.
                </p>
                <div className="mt-6">
                  <Link 
                    to="/contact" 
                    className="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent py-3.5 text-xs font-bold text-white hover:brightness-110 transition shadow-lg shadow-accent/20"
                  >
                    Request Technical Estimate <ArrowRight size={14} />
                  </Link>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>

      {/* Lightbox Modal */}
      <AnimatePresence>
        {lightboxOpen && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/95 p-4 backdrop-blur-md">
            <button
              onClick={() => setLightboxOpen(false)}
              className="absolute top-6 right-6 text-white bg-slate-800/80 p-3 rounded-full hover:bg-slate-700 transition"
            >
              <X size={24} />
            </button>
            <div className="max-w-5xl max-h-[95vh] overflow-hidden rounded-2xl">
              <img src={displayedImage} alt={project.title} className="max-w-full max-h-[90vh] object-contain" />
            </div>
          </div>
        )}
      </AnimatePresence>

      {/* Related Projects Showcase */}
      {relatedProjects.length > 0 && (
        <section className="bg-slate-50 py-20 border-t border-slate-200">
          <div className="container-x mx-auto max-w-[1400px]">
            <span className="text-xs font-bold uppercase tracking-widest text-accent">Visual Portfolio</span>
            <h3 className="mt-2 font-display text-3xl font-extrabold text-slate-900 mb-10">Explore Related Projects</h3>
            
            <div className="grid gap-6 md:grid-cols-3">
              {relatedProjects.map((proj) => (
                <article 
                  key={proj.id}
                  className="group flex flex-col overflow-hidden rounded-2xl bg-white border border-slate-200/80 shadow-sm hover:shadow-xl transition duration-300"
                >
                  <div className="aspect-[16/10] overflow-hidden relative bg-slate-900">
                    <img 
                      src={proj.image} 
                      alt={proj.title} 
                      className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" 
                      loading="lazy"
                    />
                  </div>
                  <div className="p-5 flex flex-col flex-1">
                    <div className="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                      <span className="text-accent">{proj.category}</span>
                      <span>•</span>
                      <span>{proj.location}</span>
                    </div>
                    <h4 className="mt-2 font-display text-base font-bold text-slate-900 group-hover:text-accent transition line-clamp-1">
                      <Link to={`/portfolio/${proj.id}`}>
                        {proj.title}
                      </Link>
                    </h4>
                    <div className="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                      <span className="text-[11px] font-semibold text-slate-500">
                        Area: {proj.specifications.area}
                      </span>
                      <Link 
                        to={`/portfolio/${proj.id}`}
                        className="inline-flex items-center gap-1 text-xs font-bold text-accent hover:text-orange-600 transition"
                      >
                        Explore Build <ArrowRight size={12} />
                      </Link>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Turnkey Bottom Banner */}
      <section className="bg-accent py-16 text-white">
        <div className="container-x mx-auto flex max-w-[1400px] flex-col items-center justify-between gap-8 md:flex-row">
          <div>
            <h2 className="font-display text-2xl font-bold md:text-3xl">Ready for a customized structural proposal?</h2>
            <p className="mt-2 max-w-xl text-white/85 text-xs sm:text-sm">Submit your build parameters or raw architectural drawings to our engineering team.</p>
          </div>
          <Link 
            to="/contact" 
            className="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-7 py-4 text-xs sm:text-sm font-semibold text-white hover:bg-black transition-all duration-300 shadow-lg shrink-0"
          >
            Get Free Estimate <ArrowRight size={16} />
          </Link>
        </div>
      </section>
    </Layout>
  );
}
